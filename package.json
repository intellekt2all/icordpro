{
  "name": "icordpro",
  "version": "0.5.0-starter",
  "private": true,
  "description": "IcordPro MVP monorepo starter: API, web, mobile skeleton, docs, CI and smoke-test gates.",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "node apps/api/src/server.mjs",
    "dev:api": "node apps/api/src/server.mjs",
    "dev:web": "node apps/web/src/server.js",
    "typecheck": "node scripts/typecheck.js",
    "build": "node scripts/build.js",
    "test": "node scripts/test.js && bash scripts/web-route-test.sh",
    "smoke:test": "bash scripts/smoke-test.sh",
    "local:check": "bash scripts/local-check.sh",
    "env:check": "node scripts/validate-env.js",
    "preflight:staging": "pnpm env:check && pnpm db:generate && pnpm typecheck && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
